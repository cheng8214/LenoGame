export func buildSolids4(Game g) {
    addGroundShared(g)
    addSolid(g, 1600.0, 452.0, 83.0, 82.0)
    addSolid(g, 3600.0, 409.0, 83.0, 140.0)
    addSolid(g, 6300.0, 452.0, 83.0, 82.0)
    addSolid(g, 8103.0, 194.0, 40.0, 360.0)     // 旗杆前高台（参考实现最后一段）
}

