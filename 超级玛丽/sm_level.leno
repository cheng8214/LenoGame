export func newMario(float x): Mario {
    Mario m = new Mario()
    m.x = x
    m.y = GROUND_HEIGHT - 40.0
    // ★ 碰撞框宽度取"该姿态最宽的精灵帧"：小马里奥的走动帧是 16px×2.5 = 40，
    //   若框只有 30（= 站定帧 12px 宽），精灵就会从框的右边挂出去 10px
    //   ⇒ 顶到水管/砖块时人物"陷"进方块里（参考实现 rect=image.get_rect() 也有这毛病）
    m.w = 40.0
    m.h = 40.0
    m.state = ST_WALK
    m.frame_index = 0
    m.facing_right = true
    m.allow_jump = true
    m.allow_fireball = true
    m.max_x_vel = MAX_WALK_SPEED
    m.max_y_vel = MAX_Y_VEL
    m.x_accel = WALK_ACCEL
    m.jump_vel = JUMP_VEL
    m.gravity = GRAVITY
    return m
}

