// ==================== 1-3「砖梯迷宫」====================

export func buildSolids3(Game g) {
    addGroundShared(g)
    // 上楼梯 / 下楼梯（参考实现 setup_steps 的写法）
    addSolid(g, 1000.0, 495.0, 40.0, 44.0)
    addSolid(g, 1043.0, 452.0, 40.0, 44.0)
    addSolid(g, 1086.0, 409.0, 40.0, 44.0)
    addSolid(g, 1129.0, 366.0, 40.0, 176.0)
    addSolid(g, 1400.0, 366.0, 40.0, 176.0)
    addSolid(g, 1443.0, 409.0, 40.0, 40.0)
    addSolid(g, 1486.0, 452.0, 40.0, 40.0)
    addSolid(g, 1529.0, 495.0, 40.0, 40.0)
    addSolid(g, 3000.0, 495.0, 40.0, 44.0)
    addSolid(g, 3043.0, 452.0, 40.0, 44.0)
    addSolid(g, 3086.0, 409.0, 40.0, 44.0)
    addSolid(g, 3129.0, 366.0, 40.0, 44.0)
    addSolid(g, 3400.0, 194.0, 40.0, 360.0)
    // 高台阶（通往旗杆）
    addSolid(g, 6200.0, 495.0, 40.0, 40.0)
    addSolid(g, 6243.0, 452.0, 40.0, 40.0)
    addSolid(g, 6286.0, 409.0, 40.0, 40.0)
    addSolid(g, 6329.0, 366.0, 40.0, 40.0)
    addSolid(g, 6372.0, 323.0, 40.0, 40.0)
    addSolid(g, 6415.0, 280.0, 40.0, 40.0)
    addSolid(g, 6458.0, 237.0, 40.0, 40.0)
    addSolid(g, 6501.0, 194.0, 40.0, 40.0)
    addSolid(g, 6544.0, 194.0, 40.0, 360.0)
    // 水管
    addSolid(g, 2200.0, 452.0, 83.0, 82.0)
    addSolid(g, 4400.0, 409.0, 83.0, 140.0)
    addSolid(g, 5600.0, 452.0, 83.0, 82.0)
}

