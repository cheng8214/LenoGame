// ==================== 工具（原 super_mario.leno「工具」段） ====================

// ==================== 工具 ====================

export func ovl(float ax, float ay, float aw, float ah, float bx, float by, float bw, float bh): bool {
    return ax < bx + bw and ax + aw > bx and ay < by + bh and ay + ah > by
}

// 画精灵：sx/sy/sw/sh 为源矩形；flipH/flipV 用负宽高实现（SDL_RenderTexture 支持）
export func drawSpr(Renderer r, Ptr[u8] tex, int sx, int sy, int sw, int sh,
             float dx, float dy, float dw, float dh, bool flipH, bool flipV) {
    if tex == null { return }
    if sw <= 0 or sh <= 0 { return }
    // ★ 翻转只能用"负的目标宽/高"：这套 SDL3 里负的**源**宽高会整块画不出来
    //   （马里奥朝左就消失就是这个坑），实测负 dst 才是镜像 ✓
    float ddx = dx
    float ddy = dy
    float ddw = dw
    float ddh = dh
    if flipH { ddx = dx + dw; ddw = 0.0 - dw }
    if flipV { ddy = dy + dh; ddh = 0.0 - dh }
    r.drawTextureFromTo(tex, _float(sx), _float(sy), _float(sw), _float(sh), ddx, ddy, ddw, ddh)
}

export func drawFrame(Renderer r, Ptr[u8] tex, Array[int] a, int idx,
               float dx, float dy, float scale, bool flipH, bool flipV) {
    if a.len() < 4 { return }
    int n = a.len() / 4
    if idx < 0 { idx = 0 }
    if idx >= n { idx = idx - (idx / n) * n }
    int o = idx * 4
    drawSpr(r, tex, a[o], a[o+1], a[o+2], a[o+3], dx, dy,
            _float(a[o+2]) * scale, _float(a[o+3]) * scale, flipH, flipV)
}

export func pad6(int v): string {
    string s = _str(v)
    while s.len() < 6 { s = "0" + s }
    return s
}

export func pad3(int v): string {
    string s = _str(v)
    while s.len() < 3 { s = "0" + s }
    return s
}

export func pad2(int v): string {
    string s = _str(v)
    while s.len() < 2 { s = "0" + s }
    return s
}

