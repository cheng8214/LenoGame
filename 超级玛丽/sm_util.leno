// sm_util.leno — 常量表 + 纯工具函数（无游戏状态依赖）
//
// 拆自 super_mario.leno（原文件把常量/工具/关卡/马里奥/敌人/渲染都塞在一起）。
// 用法：import "sm_util.leno" as u
//       use u.(SW, ST_FLAGPOLE, ovl, drawSpr, ...)   // 常量与函数都能这样引入
//
// ⚠ 跨模块铁律（本机实测）：`use` 只能带**类型/函数/const**，`var` 带不过来；
//   而结构体/数组型 `export var` 到了别的模块会退化成 any ⇒ 共享可变状态一律"显式传参"
import "SDL3" as SDL3
use SDL3.Renderer

