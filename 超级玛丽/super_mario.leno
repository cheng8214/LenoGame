// ==================== 工具 ====================

func ovl(float ax, float ay, float aw, float ah, float bx, float by, float bw, float bh): bool {
    return ax < bx + bw and ax + aw > bx and ay < by + bh and ay + ah > by
}

// 画精灵：sx/sy/sw/sh 为源矩形；flipH/flipV 用负宽高实现（SDL_RenderTexture 支持）
func drawSpr(Renderer r, Ptr[u8] tex, int sx, int sy, int sw, int sh,
             float dx, float dy, float dw, float dh, bool flipH, bool flipV) {
    if tex == null { return }
    if sw <= 0 or sh <= 0 { return }
    // ★ 翻转只能用"负的目标宽/高"：这套 SDL3 里负的**源**宽高会整块画不出来
    //   （马里奥朝左就消失就是这个坑），实测负 dst 才是镜像 ✓
    float ddx = dx
    float ddy = dy
    float ddw = dw
    float ddh = dh
    if flipH { ddx = dx + dw; ddw = 0.0 - dw }
    if flipV { ddy = dy + dh; ddh = 0.0 - dh }
    r.drawTextureFromTo(tex, _float(sx), _float(sy), _float(sw), _float(sh), ddx, ddy, ddw, ddh)
}

func drawFrame(Renderer r, Ptr[u8] tex, Array[int] a, int idx,
               float dx, float dy, float scale, bool flipH, bool flipV) {
    if a.len() < 4 { return }
    int n = a.len() / 4
    if idx < 0 { idx = 0 }
    if idx >= n { idx = idx - (idx / n) * n }
    int o = idx * 4
    drawSpr(r, tex, a[o], a[o+1], a[o+2], a[o+3], dx, dy,
            _float(a[o+2]) * scale, _float(a[o+3]) * scale, flipH, flipV)
}

func pad6(int v): string {
    string s = _str(v)
    while s.len() < 6 { s = "0" + s }
    return s
}

func pad3(int v): string {
    string s = _str(v)
    while s.len() < 3 { s = "0" + s }
    return s
}

func pad2(int v): string {
    string s = _str(v)
    while s.len() < 2 { s = "0" + s }
    return s
}

// ==================== 音频 ====================

func loadAudio() {
    bgm = audio.createSound("sound/main_theme.ogg")
    bgmFast = audio.createSound("sound/main_theme_sped_up.ogg")
    musDeath = audio.createSound("sound/death.wav")
    musClear = audio.createSound("sound/stage_clear.wav")
    musWorldClear = audio.createSound("sound/world_clear.wav")
    musOver = audio.createSound("sound/game_over.ogg")
    musInvincible = audio.createSound("sound/invincible.ogg")
    musFlag = audio.createSound("sound/flagpole.wav")
    if not bgm.ok {
        print("[提示] 音频未加载（静音运行）")
        g_audio = false
        return
    }
    bgm.setLooping(true)
    bgm.setVolume(0.45)
    bgmFast.setLooping(true)
    bgmFast.setVolume(0.45)
    musInvincible.setLooping(true)
    musInvincible.setVolume(0.5)
    sfxSmallJump = audio.createSfx("sound/small_jump.ogg", 3, 0.55)
    sfxBigJump = audio.createSfx("sound/big_jump.ogg", 3, 0.55)
    sfxStomp = audio.createSfx("sound/stomp.ogg", 3, 0.6)
    sfxKick = audio.createSfx("sound/kick.ogg", 3, 0.6)
    sfxCoin = audio.createSfx("sound/coin.ogg", 3, 0.5)
    sfxBump = audio.createSfx("sound/bump.ogg", 3, 0.5)
    sfxPowerup = audio.createSfx("sound/powerup.ogg", 2, 0.6)
    sfxPowerupApp = audio.createSfx("sound/powerup_appears.ogg", 2, 0.6)
    sfxPipe = audio.createSfx("sound/pipe.ogg", 2, 0.5)
    sfxFireball = audio.createSfx("sound/fireball.ogg", 3, 0.5)
    sfxOneUp = audio.createSfx("sound/one_up.ogg", 2, 0.6)
    sfxBrickSmash = audio.createSfx("sound/brick_smash.ogg", 3, 0.55)
    g_audio = true
}

func stopMusic() {
    if not g_audio { return }
    bgm.stop(); bgmFast.stop(); musInvincible.stop()
}

func setMusic(int mode) {      // 1 普通主题 2 加速主题
    if not g_audio { return }
    if g_music_mode == mode { return }
    stopMusic()
    g_music_mode = mode
    if mode == 1 { bgm.play() } else if mode == 2 { bgmFast.play() }
}

func playJingle(Sound s) {
    if not g_audio { return }
    stopMusic()
    s.play()
}

