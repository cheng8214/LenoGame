// super_mario.leno — 超级玛丽（Leno 版，按 Python 原版重写）
//
// ★ 本玩法是 justinarmstrong 的 pygame 版《Super Mario Bros 1-1》的忠实移植：
//   物理常量、马里奥状态机、关卡几何（地面/水管/台阶/砖块/金币箱/旗杆）、
//   碰撞流程（先 x 后 y、按碰撞组 elif 顺序）、敌人/龟壳/道具行为、旗杆收尾流程，
//   全部照抄参考实现（D:\软件\超级玛丽-python-master\-python-master\data\**），
//   只把渲染/音频换成 LenoSDL3 + LenoMusic（写法参考 飞机大战/plane_war.leno）。
//
//   参考对应：
//     data/constants.py          -> sm_util.leno（常量）
//     data/components/mario.py   -> sm_mario.leno（马里奥帧/状态机/碰撞）
//     data/states/level1.py      -> 本文件（每帧流程 + 收尾）+ sm_level.leno（关卡搭建）
//     data/components/enemies.py -> sm_items.leno（敌人/龟壳）
//     data/components/*.py       -> sm_items.leno（砖块/金币箱/道具/金币/碎片/旗杆检查点）
//
// ★ 2026-10-12 拆分（原文件 3100+ 行太大，按 LenoMusic 的做法拆成多文件）：
//     sm_util.leno   常量表 + 纯工具（ovl/drawSpr/drawFrame/pad*）
//     sm_level.leno  四关几何 / 物品 / 敌人 / 检查点数据 + setupLevel/newMario
//     sm_room.leno   地下金币房（钻/出水管）
//     sm_items.leno  砖块 / 金币箱 / 道具 / 金币 / 碎片 / 飘字 / 敌人 / 龟壳 / 位置判定
//     sm_mario.leno  马里奥帧表 / 状态机 / 碰撞
//     sm_render.leno 贴图加载 + 全部绘制 / HUD / 菜单
//     sm_audio.leno  音频（Sound/Sfx 收在模块里，对外只暴露 playXxx 语义化接口）
//     sm_types.leno  数据结构
//   本文件只留：全局状态 + 每帧流程（关卡状态机）+ 输入 + main。
//
// 跨模块三条铁律（本机实测，别踩）：
//   1) `use 模块.(A, B)` 只能引入**类型/函数**；常量不行（要写 模块.X），var 也不行
//   2) 结构体/数组型的 `export var` 到别的模块会退化成 any ⇒ 共享可变状态一律**显式收 Game g**
//   3) 常量跨模块用不了裸名 ⇒ 本文件用 const 起别名（见下），正文写法与拆分前完全一致
//
// 操作：← → 移动   A / 空格 / ↑ 跳跃   S / Shift 加速跑（火球键）   ↓ 蹲下   回车 开始   ESC 退出

import "SDL3" as SDL3
use SDL3.(Event, Renderer, WindowFlag, Scancode, Font, Flip, ScaleMode)
import dirs
import "sm_types.leno" as types
use types.(Mario, Box, Brick, CoinBox, Enemy, Powerup, Coin, Piece, ScorePop, Checkpoint, Keys, Game)
import "sm_util.leno" as u
use u.(ovl, drawSpr, drawFrame, pad6, pad3, pad2)
import "sm_level.leno" as lv
use lv.(newMario, setupLevel, clearLevelData, addCoinBox, addSolid, addBrick, addCp, addEnemy, addEndCheckpoints, addGroundShared)
import "sm_items.leno" as it
use it.(findSolid, findBrick, findCoinBox, findEnemy, findShell, findPowerup, addScore, addScoreOneUp, spawnPieces, checkEnemyOnBrick, brickStartBump, bricksUpdate, coinBoxStartBump, coinboxesUpdate, powerupsUpdate, coinsUpdate, piecesUpdate, popsUpdate, cleanDead, enemyAnimation, adjustEnemyPosition, adjustShellPosition, adjustPowerupPosition)
import "sm_room.leno" as room
use room.(checkPipeEntry, warpsUpdate, roomCoinsUpdate, buildCoinRoom)
import "sm_audio.leno" as aud
use aud.(loadAudio, uninitAudio, stopMusic, setMusic, resetMusicMode, playDeathJingle, playFlagJingle, playGameOverJingle, playWorldClearJingle, playInvincibleMusic, stopInvincibleMusic, playJump, playStomp, playKick, playCoin, playBump, playPowerup, playPowerupAppears, playPipe, playFireball, playOneUp, playBrickSmash, isWorldClearPlaying, startTimeWarning, updateTimeWarning, updateCountDown)
import "sm_mario.leno" as mario
use mario.(MFrame, marioFrame, marioAlpha, startDeathJump, marioUpdate, adjustMarioPosition, setMarioBottomOfPole)
import "sm_render.leno" as rnd
use rnd.(loadTextures, renderGame)

// ---- 常量别名（单一数据源在 sm_util.leno：跨模块常量只能 u.X 访问） ----
const int SW = u.SW
const int SH = u.SH
const int GROUND_HEIGHT = u.GROUND_HEIGHT
const float SIZE_MULT = u.SIZE_MULT
const float BRICK_MULT = u.BRICK_MULT
const float BG_MULT = u.BG_MULT
const float WALK_ACCEL = u.WALK_ACCEL
const float RUN_ACCEL = u.RUN_ACCEL
const float RUN_SPEED = u.RUN_SPEED
const float SMALL_TURNAROUND = u.SMALL_TURNAROUND
const float GRAVITY = u.GRAVITY
const float JUMP_GRAVITY = u.JUMP_GRAVITY
const float JUMP_VEL = u.JUMP_VEL
const float FAST_JUMP_VEL = u.FAST_JUMP_VEL
const float MAX_Y_VEL = u.MAX_Y_VEL
const float MAX_WALK_SPEED = u.MAX_WALK_SPEED
const int ST_STAND = u.ST_STAND
const int ST_WALK = u.ST_WALK
const int ST_JUMP = u.ST_JUMP
const int ST_FALL = u.ST_FALL
const int ST_SMALLTOBIG = u.ST_SMALLTOBIG
const int ST_BIGTOFIRE = u.ST_BIGTOFIRE
const int ST_BIGTOSMALL = u.ST_BIGTOSMALL
const int ST_FLAGPOLE = u.ST_FLAGPOLE
const int ST_BOTTOMPOLE = u.ST_BOTTOMPOLE
const int ST_TOCASTLE = u.ST_TOCASTLE
const int ST_ENDFALL = u.ST_ENDFALL
const int ST_DEATHJUMP = u.ST_DEATHJUMP
const int ES_WALK = u.ES_WALK
const int ES_FALL = u.ES_FALL
const int ES_JUMPEDON = u.ES_JUMPEDON
const int ES_SHELLSLIDE = u.ES_SHELLSLIDE
const int ES_DEATHJUMP = u.ES_DEATHJUMP
const int PS_REVEAL = u.PS_REVEAL
const int PS_SLIDE = u.PS_SLIDE
const int PS_FALL = u.PS_FALL
const int PS_RESTING = u.PS_RESTING
const int PS_BOUNCE = u.PS_BOUNCE
const int PS_FLYING = u.PS_FLYING
const int PS_BOUNCING = u.PS_BOUNCING
const int PS_EXPLODING = u.PS_EXPLODING
const int BS_RESTING = u.BS_RESTING
const int BS_BUMPED = u.BS_BUMPED
const int BS_OPENED = u.BS_OPENED
const int CT_NONE = u.CT_NONE
const int CT_COIN = u.CT_COIN
const int CT_MUSHROOM = u.CT_MUSHROOM
const int CT_FIREFLOWER = u.CT_FIREFLOWER
const int CT_STAR = u.CT_STAR
const int CT_SIXCOINS = u.CT_SIXCOINS
const int CT_LIFE = u.CT_LIFE
const int PK_MUSHROOM = u.PK_MUSHROOM
const int PK_FIREFLOWER = u.PK_FIREFLOWER
const int PK_STAR = u.PK_STAR
const int PK_LIFE = u.PK_LIFE
const int PK_FIREBALL = u.PK_FIREBALL
const int EK_GOOMBA = u.EK_GOOMBA
const int EK_KOOPA = u.EK_KOOPA
const int LS_NOTFROZEN = u.LS_NOTFROZEN
const int LS_FROZEN = u.LS_FROZEN
const int LS_CASTLE = u.LS_CASTLE
const int LS_FIREWORKS = u.LS_FIREWORKS
const int GS_MENU = u.GS_MENU
const int GS_PLAY = u.GS_PLAY
const int GS_OVER = u.GS_OVER
const int GS_CLEAR = u.GS_CLEAR
const int MAX_LEVEL = u.MAX_LEVEL
const float ROOM_W = u.ROOM_W
const float ROOM_FLOOR_Y = u.ROOM_FLOOR_Y
const float ROOM_PIPE_W = u.ROOM_PIPE_W
const float ROOM_PIPE_H = u.ROOM_PIPE_H
const float ROOM_PIPE_TOP = u.ROOM_PIPE_TOP
const float LEVEL1_PIPE_TOP = u.LEVEL1_PIPE_TOP
const float ROOM_ENTRY_X = u.ROOM_ENTRY_X
const float ROOM_EXIT_X = u.ROOM_EXIT_X
const float ROOM_WALL_X = u.ROOM_WALL_X
const float LEVEL1_ENTRY_PIPE = u.LEVEL1_ENTRY_PIPE
const float LEVEL1_RETURN_PIPE = u.LEVEL1_RETURN_PIPE
const float LEVEL_WIDTH = u.LEVEL_WIDTH
const float WARP_SINK_FRAMES = u.WARP_SINK_FRAMES
const float POLE_BASE_TOP = u.POLE_BASE_TOP

// ==================== 全局 ====================

// 唯一的可变状态容器：按键 G.K、马里奥 G.mario、关卡数据（solids/bricks/...）、分数、时间…
// 拆分后各模块不共享全局，改为"显式收 Game g"（见 super_mario.leno 头部的三条铁律）
Game G = new Game()

Ptr[u8] g_ren = null                // 渲染器句柄（只在加载贴图时要）

// 自检用（环境变量驱动，正常玩不受影响）
string mShot = ""
int mShotAt = 2
int mFrames = 0

// （关卡数据段已迁到 sm_level.leno、音频段已迁到 sm_audio.leno）

func newGame(): Game {
    Game g = new Game()
    g.state = GS_MENU
    g.lives = 3
    g.score = 0
    g.coins = 0
    g.time = 400
    g.level_w = LEVEL_WIDTH
    g.viewport_x = 0.0
    g.K = new Keys()            // 按键状态（原来是个模块级全局 K，拆模块后归 Game）
    g.mario = newMario(110.0)
    return g
}

// ==================== 检查点 / 旗杆 / 死亡（level1.py） ====================

func spawnGroup(int id) {
    float sx = G.viewport_x + SW
    int idx = 0
    for 0:G.enemies.len() - 1 to i {
        Enemy e = G.enemies[i]
        if e.group != id { continue }
        e.x = sx + _float(idx) * 60.0
        e.y = e.home_y - e.h
        e.x_vel = -2.0
        e.direction = 0
        e.state = ES_WALK
        e.frame_index = 0
        e.active = true
        e.released = true
        e.in_shell = false
        idx = idx + 1
    }
}

func createFlagScore(float bottom) {
    int v = 5000
    if bottom > (GROUND_HEIGHT - 40.0 - 40.0) { v = 100 }
    else if bottom > (GROUND_HEIGHT - 40.0 - 160.0) { v = 400 }
    else if bottom > (GROUND_HEIGHT - 40.0 - 240.0) { v = 800 }
    else if bottom > (GROUND_HEIGHT - 40.0 - 360.0) { v = 2000 }
    G.score = G.score + v
    ScorePop s = new ScorePop()
    s.x = 8518.0 - G.viewport_x
    s.y = GROUND_HEIGHT - 60.0
    s.text = _str(v)
    s.active = true
    G.pops.add(s)
}

func checkPoints() {
    Mario m = G.mario
    for 0:G.cps.len() - 1 to i {
        Checkpoint c = G.cps[i]
        if c.done { continue }
        if not ovl(m.x, m.y, m.w, m.h, c.x, c.y, c.w, c.h) { continue }
        c.done = true
        if c.kind == 0 {
            spawnGroup(c.group)
        } else if c.kind == 1 {
            m.state = ST_FLAGPOLE
            m.invincible = false
            m.frame_tint = 0
            stopInvincibleMusic()
            m.flag_right = c.x + c.w
            m.flag_timer = 0.0
            if m.y + m.h < G.flag_y { m.y = G.flag_y - m.h }
            G.flag_state = 1
            createFlagScore(m.y + m.h)
            playFlagJingle()
        } else if c.kind == 2 {
            G.level_state = LS_CASTLE
            m.in_castle = true
        } else if c.kind == 3 {
            if m.y_vel < 0.0 {
                // 隐藏 1UP 箱：生成在检查点矩形内（与参考一致：rect.bottom - 40）
                addCoinBox(G, c.x, c.y + c.h - 40.0, CT_LIFE)
                int n = G.coinboxes.len() - 1
                coinBoxStartBump(G, G.coinboxes[n])
                m.y_vel = 7.0
                m.y = G.coinboxes[n].y + G.coinboxes[n].h
                m.state = ST_FALL
            }
        }
    }
}

func flagUpdate() {
    if G.flag_state == 1 {
        G.flag_y = G.flag_y + 5.0
        if G.flag_y + 40.0 >= 485.0 { G.flag_state = 2; G.flag_y = 445.0 }
    }
    if G.flag_state == 2 and G.mario.state == ST_FLAGPOLE {
        setMarioBottomOfPole(G.mario)
    }
}

func restartLevel() {
    G.lives = G.lives - 1
    if G.lives <= 0 {
        G.state = GS_OVER
        G.lives = 3
        G.score = 0
        G.coins = 0
        playGameOverJingle()
        return
    }
    float start = 0.0
    if G.mario.x > 3670.0 { start = 3440.0 }
    G.viewport_x = start
    G.level_state = LS_NOTFROZEN
    G.death_wait = 0.0
    setupLevel(G, G.level)
    G.mario = newMario(start + 110.0)
    G.state = GS_PLAY
    resetMusicMode()
    setMusic(1)
}

func checkForMarioDeath() {
    if G.mario.y > SH and not G.mario.in_castle {
        G.mario.dead = true
        G.mario.x_vel = 0.0
        G.level_state = LS_FROZEN
    }
    if G.mario.dead {
        G.death_wait = G.death_wait + 16.0
        if G.death_wait > 3000.0 {
            G.death_wait = 0.0
            restartLevel()
        }
    }
}

func updateViewport() {
    Mario m = G.mario
    float third = G.viewport_x + 266.0
    if m.x_vel > 0.0 and (m.x + m.w * 0.5) >= third {
        float mult = 0.5
        if (m.x + m.w) >= (G.viewport_x + 400.0) { mult = 1.0 }
        float nw = G.viewport_x + mult * m.x_vel
        float highest = G.level_w - _float(SW)
        if nw > highest { nw = highest }
        G.viewport_x = nw
    }
}

func updateTime() {
    if G.mario.dead or G.mario.in_castle { return }
    G.time_timer = G.time_timer + 16.0
    if G.time_timer > 400.0 {
        G.time_timer = 0.0
        G.time = G.time - 1
        if G.time == 100 { startTimeWarning() }   // 先放 out_of_time 警报，放完由 updateTimeWarning() 切加速主题
        else if G.time <= 0 {
            G.time = 0
            G.level_state = LS_FROZEN
            startDeathJump(G, G.mario)
        }
    }
}

func updateDying() {
    for 0:G.dying.len() - 1 to i {
        Enemy e = G.dying[i]
        if not e.active { continue }
        if e.state == ES_JUMPEDON {
            if (G.now - e.death_timer) > 500.0 { e.active = false }
        } else {
            e.y = e.y + e.y_vel
            e.x = e.x + e.x_vel
            e.y_vel = e.y_vel + e.gravity
            if e.y > SH + 60.0 { e.active = false }
        }
    }
}

func updateAllSprites() {
    marioUpdate(G)
    checkPipeEntry(G)                 // ↓ 钻水管（1-1 那根高水管 / 金币房出口水管）
    if G.in_room { roomCoinsUpdate(G) }
    flagUpdate()
    checkPoints()
    for 0:G.enemies.len() - 1 to i { enemyAnimation(G, G.enemies[i]) }
    updateDying()
    for 0:G.shells.len() - 1 to i { enemyAnimation(G, G.shells[i]) }
    bricksUpdate(G)
    coinboxesUpdate(G)
    powerupsUpdate(G)
    coinsUpdate(G)
    piecesUpdate(G)
    adjustMarioPosition(G)
    adjustEnemyPosition(G)
    adjustShellPosition(G)
    adjustPowerupPosition(G)
    if G.mario.in_transition { G.level_state = LS_FROZEN } 
    else if G.level_state == LS_FROZEN and not G.mario.dead { G.level_state = LS_NOTFROZEN }
    checkForMarioDeath()
    updateViewport()
    updateTime()
    popsUpdate(G)
    cleanDead(G)
}

func updateDuringTransition() {
    marioUpdate(G)
    if G.mario.in_transition { G.level_state = LS_FROZEN } 
    else if G.level_state == LS_FROZEN and not G.mario.dead { G.level_state = LS_NOTFROZEN }
    flagUpdate()
    coinboxesUpdate(G)
    updateDying()
    popsUpdate(G)
    checkForMarioDeath()
    cleanDead(G)
}

func updateInCastle() {
    updateCountDown(G.time > 0)   // 城堡倒计时滴答（count_down.ogg）：扣时间期间在播，扣完停
    if G.time > 0 {
        // 剩余时间换分：一帧结算 4 个单位（原来是 3 帧才扣 1 个 ⇒ 满 400 个单位
        // 要跑 1200 帧 ≈ 20 秒，玩家进城堡后得干等十几秒才进下一关；原版是一口气快结算完）
        int dec = 4
        if G.time < dec { dec = G.time }
        G.time = G.time - dec
        G.score = G.score + 50 * dec
    } else {
        G.level_state = LS_FIREWORKS
        G.castle_flag_on = true
        G.castle_flag_y = 370.0
        G.clear_timer = 0.0
        playWorldClearJingle()
    }
    updateDying()
    popsUpdate(G)
    cleanDead(G)
}

func updateFlagAndFireworks() {
    if G.castle_flag_y > 322.0 { G.castle_flag_y = G.castle_flag_y - 2.0 }
    G.clear_timer = G.clear_timer + 16.0
    popsUpdate(G)
    // 通关 jingle（world_clear.wav 6.3 秒）**放完**再进下一关：原来写死 2600ms（≈2.6 秒）
    // 就切关，音乐放到一半被掐掉。
    //   · 至少 620ms：够城堡升旗（约 400ms）再留一点白；音频没启用 / 该音效加载失败时
    //     isPlaying() 恒为 false ⇒ 也走这条路，不会死等
    //   · 最多 10 秒：万一设备异常一直报"在播"，兜底放行别卡死
    bool music_wait = G.clear_timer < 10000.0 and isWorldClearPlaying()
    if G.clear_timer > 620.0 and not music_wait {
        if G.level < MAX_LEVEL { startLevel(G.level + 1) } else { G.state = GS_CLEAR }
    }
    cleanDead(G)
}

func updateLevel() {
    warpsUpdate(G)                    // 钻水管动画（冻结期间也要跑）
    if G.banner_timer > 0.0 { G.banner_timer = G.banner_timer - 16.0 }
    if G.level_state == LS_NOTFROZEN { updateAllSprites() }
    else if G.level_state == LS_FROZEN { updateDuringTransition() }
    else if G.level_state == LS_CASTLE { updateInCastle() }
    else if G.level_state == LS_FIREWORKS { updateFlagAndFireworks() }
}

// ==================== 输入 ====================

func startLevel(int lv) {
    G.level = lv
    G.viewport_x = 0.0
    G.level_state = LS_NOTFROZEN
    G.death_wait = 0.0
    setupLevel(G, lv)
    G.state = GS_PLAY
    resetMusicMode()
    setMusic(1)
}

func handleEvent(Event e): bool {
    if e.isQuit() or e.isWindowClose() { return false }
    if e.isKeyDown() {
        int sc = e.scancode()
        if sc == Scancode.ESCAPE { return false }
        if G.state == GS_MENU {
            if sc == Scancode.RETURN { startLevel(1) }
            return true
        }
        if G.state == GS_OVER or G.state == GS_CLEAR {
            if sc == Scancode.RETURN {
                G.state = GS_MENU
                G.score = 0
                G.coins = 0
                G.lives = 3
                stopMusic()
            }
            return true
        }
        if sc == Scancode.LEFT { G.K.left = true }
        else if sc == Scancode.RIGHT { G.K.right = true }
        else if sc == Scancode.DOWN { G.K.down = true }
        else if sc == Scancode.UP or sc == Scancode.SPACE or sc == Scancode.A { G.K.jump = true }
        else if sc == Scancode.S or sc == Scancode.LSHIFT or sc == Scancode.RSHIFT { G.K.action = true }
    } else if e.isKeyUp() {
        int sc = e.scancode()
        if sc == Scancode.LEFT { G.K.left = false }
        else if sc == Scancode.RIGHT { G.K.right = false }
        else if sc == Scancode.DOWN { G.K.down = false }
        else if sc == Scancode.UP or sc == Scancode.SPACE or sc == Scancode.A { G.K.jump = false }
        else if sc == Scancode.S or sc == Scancode.LSHIFT or sc == Scancode.RSHIFT { G.K.action = false }
    }
    return true
}

// ==================== 主函数 ====================

main() {
    _console(false)
    var win = SDL3.createWindow({
        title: "超级玛丽 1-1 — Leno",
        w: SW,
        h: SH,
        flags: 0
    })
    if not win.ok {
        print("[错误] 窗口创建失败")
        return
    }
    SDL3.ttfInit()
    // 两种字体：
    //   font      —— 系统字体（支持中文，用于菜单/说明/中文提示）
    //   fontSmall —— 参考实现自带的 Fixedsys500c.ttf（像素风，用于 HUD / 分数飘字等纯 ASCII 文本）
    var font = SDL3.createFontAuto(20.0)
    var fontPath = dirs.res_dir() + "/font/Fixedsys500c.ttf"
    var fontSmall = SDL3.createFont(fontPath, 14.0)
    if not fontSmall.ok { fontSmall = SDL3.createFontAuto(14.0) }
    win.setMaxFPS(60)

    G = newGame()
    G.font = font
    G.fontSmall = fontSmall
    G.K = new Keys()
    loadAudio()

    // ---- 自检钩子（MSHOT=<png> MAUTO_RUN=1 时才生效）----
    var eShot = _env("MSHOT")
    if eShot != null { mShot = _str(eShot) }
    var eAt = _env("MSHOT_AT")
    if eAt != null { mShotAt = _int(_str(eAt)) }
    var eRun = _env("MAUTO_RUN")
    bool mAutoRun2 = false
    if eRun != null { mAutoRun2 = true }
    if mAutoRun2 {
        int lv0 = 1
        var eLv = _env("MLEVEL")
        if eLv != null { lv0 = _int(_str(eLv)) }
        startLevel(lv0)
        G.K.right = true
        // 自检时周期性跳跃，方便验证顶砖块 / 踩敌人
        var eJ = _env("MAUTO_JUMP")
        if eJ != null { G.K.jump = true }
    }
    // MFLAG=<0..4>：把马里奥直接放到旗杆上方（脚底 200+k），专测"滑杆 → 走城堡 →
    // 换分 → 通关音乐放完 → 进下一关"整条收尾链（配 MSHOT=<png> MSHOT_AT=<帧> 用）。
    // 不设就正常从菜单开始，正常玩不受影响。
    var eFlagDbg = _env("MFLAG")
    if eFlagDbg != null {
        startLevel(1)
        G.viewport_x = LEVEL_WIDTH - _float(SW)     // 相机推到关卡尾，城堡可见
        Mario fm = G.mario
        fm.x = 8469.0                               // 右缘 8509，压住旗杆检查点（8504..8510）
        fm.y = 200.0 + _float(_int(_str(eFlagDbg))) - fm.h
        fm.state = ST_WALK
        fm.x_vel = 0.0
        fm.y_vel = 0.0
    }
    if mShot != "" {
        win.setOverlay(func(Renderer r) {
            mFrames = mFrames + 1

            if mFrames >= mShotAt {
                var wsz = win.getSize()
                var s = r.readPixelsAt(0, 0, wsz.w, wsz.h)
                bool ok = false
                if s != null { ok = SDL3.saveImagePNG(s, mShot) }
                print("[shot] " + mShot + " ok=" + _str(ok) + " 帧=" + _str(mFrames) + "\n")
                SDL3.requestExit()
            }
        })
    }

    print("[OK] 超级玛丽启动成功")
    print("     ← → 移动  A/空格 跳跃  S/Shift 加速跑  回车 开始  ESC 退出")

    win.run(
        func(Event ev): bool {
            return handleEvent(ev)
        },
        func(Renderer r) {
            if g_ren == null {
                g_ren = r.handle
                loadTextures(g_ren)
            }
            G.now = _float(SDL3.getTicks())    // 每帧快照：各模块统一读 g.now
            updateTimeWarning()                // 时间警报放完 → 自动切加速主题（与关卡状态无关，每帧看一眼）
            if G.state == GS_PLAY {
                updateLevel()
                G.frame = G.frame + 1.0
            } else {
                G.frame = G.frame + 1.0
            }
            renderGame(G, r)
        }
    )

    uninitAudio()
    if fontSmall.ok { fontSmall.close() }
    if font.ok { font.close() }
    win.destroy()
    SDL3.quit()
    print("超级玛丽退出")
}
