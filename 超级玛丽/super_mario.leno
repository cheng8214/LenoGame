func addBrick(float x, float y, int contents) {
    Brick b = new Brick()
    b.x = x; b.y = y; b.rest_y = y
    b.contents = contents
    if contents == CT_SIXCOINS { b.coin_total = 6 }
    G.bricks.add(b)
}

func addCoinBox(float x, float y, int contents) {
    CoinBox c = new CoinBox()
    c.x = x; c.y = y; c.rest_y = y
    c.contents = contents
    G.coinboxes.add(c)
}

func addCp(float x, int kind, int group, float y, float w, float h) {
    Checkpoint c = new Checkpoint()
    c.x = x; c.y = y; c.w = w; c.h = h
    c.kind = kind; c.group = group
    G.cps.add(c)
}

func addEnemy(int kind, int group, float home_y) {
    Enemy e = new Enemy()
    e.kind = kind; e.group = group; e.home_y = home_y
    e.direction = 0
    e.x_vel = -2.0
    if kind == EK_GOOMBA { e.w = 40.0; e.h = 40.0 } else { e.w = 40.0; e.h = 60.0 }
    e.active = false
    G.enemies.add(e)
}

func clearLevelData() {
    G.solids = []
    G.bricks = []
    G.coinboxes = []
    G.enemies = []
    G.shells = []
    G.dying = []
    G.powerups = []
    G.coins_arr = []
    G.pieces = []
    G.pops = []
    G.cps = []
    G.flag_x = 8505.0
    G.flag_y = 100.0
    G.flag_state = 0
    G.castle_flag_y = 322.0
    G.castle_flag_on = false
    G.level_state = LS_NOTFROZEN
    G.time = 400
    G.time_timer = 0.0
    G.death_wait = 0.0
    G.clear_timer = 0.0
    G.banner_timer = 0.0
}

