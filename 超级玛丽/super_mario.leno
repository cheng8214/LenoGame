    addEnemy(EK_GOOMBA, 9, 538.0)
    addEnemy(EK_GOOMBA, 9, 538.0)
    addEnemy(EK_GOOMBA, 10, 538.0)
    addEnemy(EK_GOOMBA, 10, 538.0)

    // setup_checkpoints
    addCp(510.0, 0, 1, 0.0, 10.0, 600.0)
    addCp(1400.0, 0, 2, 0.0, 10.0, 600.0)
    addCp(1740.0, 0, 3, 0.0, 10.0, 600.0)
    addCp(3080.0, 0, 4, 0.0, 10.0, 600.0)
    addCp(3750.0, 0, 5, 0.0, 10.0, 600.0)
    addCp(4150.0, 0, 6, 0.0, 10.0, 600.0)
    addCp(4470.0, 0, 7, 0.0, 10.0, 600.0)
    addCp(4950.0, 0, 8, 0.0, 10.0, 600.0)
    addCp(5100.0, 0, 9, 0.0, 10.0, 600.0)
    addCp(6800.0, 0, 10, 0.0, 10.0, 600.0)
    addCp(8504.0, 1, 0, 5.0, 6.0, 600.0)
    addCp(8775.0, 2, 0, 0.0, 10.0, 600.0)
    addCp(2740.0, 3, 12, 360.0, 40.0, 12.0)
    } else if lv == 2 {
        buildSolids2()
        items2()
    } else if lv == 3 {
        buildSolids3()
        items3()
    } else {
        buildSolids4()
        items4()
    }
    // setup_mario：站在地面高度、视野左侧 +110
    G.mario = newMario(G.viewport_x + 110.0)
    G.banner_timer = 1500.0          // 开场 "1-N" 横幅
}

