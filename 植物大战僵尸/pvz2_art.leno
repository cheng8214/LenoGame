// 裁剪矩形 cx, cy, cw, ch（0 = 不裁剪，取整帧）
// 不手写对齐表（极易错位），改为运行时按动画 id 显式设置；数据来自 Python 的 PLANT_RECT / ZOMBIE_RECT。
export var A_CX = []
export var A_CY = []
export var A_CW = []
export var A_CH = []

func setCrop(int id, int x, int y, int w, int h) {
    A_CX[id] = x
    A_CY[id] = y
    A_CW[id] = w
    A_CH[id] = h
}

// 初始化裁剪表（newGame 时调用一次）
export func initCrops() {
    if A_CX.len() > 0 { return }
    for 0 : ANIM_N - 1 to i {
        A_CX.add(0)
        A_CY.add(0)
        A_CW.add(0)
        A_CH.add(0)
    }
    // ---- 植物（PLANT_RECT）----
    setCrop(15, 0, 0, 75, 55)        // 土豆雷
    setCrop(17, 10, 140, 80, 86)     // 窝瓜
    setCrop(18, 10, 140, 80, 86)     // 窝瓜瞄准
    setCrop(19, 10, 140, 80, 86)     // 窝瓜攻击
    setCrop(20, 0, 0, 100, 114)      // 大嘴花
    setCrop(21, 0, 0, 100, 114)      // 大嘴花攻击
    setCrop(22, 0, 0, 100, 114)      // 大嘴花消化
    setCrop(24, 3, 0, 80, 35)        // 地刺
    setCrop(26, 0, 28, 35, 38)       // 小喷菇
    setCrop(27, 1, 0, 39, 65)        // 小喷菇睡觉
    // ---- 子弹 ----
    setCrop(62, 28, 0, 28, 34)       // 豌豆
    setCrop(63, 26, 0, 30, 34)       // 冰豌豆
    setCrop(65, 0, 1, 55, 21)        // 蘑菇孢子
    setCrop(66, 0, 1, 55, 21)        // 海蘑菇孢子
    // ---- 僵尸（ZOMBIE_RECT：只裁 x/宽，高度取整帧）----
    setCrop(70, 62, 0, 90, 0)        // 普通 走
    setCrop(71, 62, 0, 90, 0)        // 普通 啃
    setCrop(72, 62, 0, 90, 0)        // 普通 掉头
    setCrop(73, 62, 0, 90, 0)        // 普通 掉头啃
    setCrop(74, 0, 0, 164, 0)        // 普通 死
    setCrop(75, 68, 0, 80, 0)        // 爆炸死
    setCrop(77, 56, 0, 110, 0)       // 旗帜 走
    setCrop(78, 60, 0, 100, 0)       // 旗帜 啃
    setCrop(79, 55, 0, 110, 0)       // 旗帜 掉头
    setCrop(80, 55, 0, 110, 0)       // 旗帜 掉头啃
    setCrop(81, 80, 0, 80, 0)        // 路障 走
    setCrop(82, 79, 0, 87, 0)        // 路障 啃
    setCrop(83, 54, 0, 90, 0)        // 铁桶 走
    setCrop(84, 46, 0, 90, 0)        // 铁桶 啃
    setCrop(85, 48, 0, 92, 0)        // 读报 走
    setCrop(86, 48, 0, 92, 0)        // 读报 啃
    setCrop(87, 40, 0, 98, 0)        // 读报 无报纸
    setCrop(88, 48, 0, 92, 0)        // 读报 无报纸啃
    setCrop(90, 44, 0, 96, 0)        // 读报 掉头
    setCrop(91, 48, 0, 92, 0)        // 读报 掉头啃
    setCrop(92, 0, 0, 100, 0)        // 读报 死
    setCrop(116, 55, 0, 105, 0)      // 鸭子 走
    setCrop(117, 55, 0, 105, 0)      // 鸭子 啃
    setCrop(118, 55, 0, 105, 0)      // 鸭子 游
    setCrop(119, 55, 0, 105, 0)      // 鸭子 掉头
    setCrop(120, 55, 0, 105, 0)      // 鸭子 死
    setCrop(121, 55, 0, 105, 0)      // 鸭子路障 走
    setCrop(122, 55, 0, 105, 0)      // 鸭子路障 啃
    setCrop(123, 55, 0, 105, 0)      // 鸭子路障 游
    setCrop(124, 55, 0, 105, 0)      // 鸭子铁桶 走
    setCrop(125, 55, 0, 105, 0)      // 鸭子铁桶 啃
    setCrop(126, 55, 0, 105, 0)      // 鸭子铁桶 游
    setCrop(132, 41, 0, 100, 0)      // 铁门 走
    setCrop(133, 41, 0, 100, 0)      // 铁门 啃
}
export func animPath(string rel): string {
    return dirs.res_dir() + "/image/" + rel
}

// 加载一个动画组（帧号 0.. 连续探测）
export func loadAnimGroup(Game g, Renderer r, int id) {
    if g.animOk[id] { return }
    var an = new FrameAnim()
    an.interval = A_INT[id]
    an.tex = []
    an.fw = []
    an.fh = []
    var prefix = animPath(A_PATH[id]) + "_"
    var i = 0
    while i < 90 {
        var f = prefix + i + ".png"
        if not files.exists(f) { break }
        var t = SDL3.loadImageTexture(r.handle, f)
        if t == null { break }
        var[float, float](tw, th) = r.getTextureSize(t)
        if A_CW[id] > 0 { tw = _float(A_CW[id]) }
        if A_CH[id] > 0 { th = _float(A_CH[id]) }
        an.tex.add(t)
        an.fw.add(tw)
        an.fh.add(th)
        i = i + 1
    }
    an.n = i
    g.anims[id] = an
    g.animOk[id] = true
}

// 渐进加载：本次最多加载 n 组；返回下一批起始下标
export func loadAnimStep(Game g, Renderer r, int from, int n): int {
    var end = from + n
    if end > ANIM_N { end = ANIM_N }
    for from : end - 1 to i {
        loadAnimGroup(g, r, i)
    }
    return end
}

// ==================== 绘制 ====================

// ⚠ 这三个函数的 frame 参数是**帧号累加值**（各实体每帧 +1.0 的那个 aframe），
//   不是帧下标！内部必须过 frameIdx 按 interval 换算：
//   原来写成 `_int(frame)` ⇒ 直接拿累加值当下标，动画帧每帧都在换，等于按渲染帧率播：
//   植物 idle（interval=4）快 4 倍（"植物摇得飞快"）、僵尸走（interval=11）快 11 倍、
//   阳光/子弹/墓碑同理。游戏逻辑侧的判定都在用 frameIdx，只有绘制这三处漏了。

// 底部中心锚点（植物/阳光/墓碑用）
export func drawAnim(Renderer r, FrameAnim a, float frame, float x, float y) {
    if a.n <= 0 { return }
    var fi = frameIdx(a, frame)
    var t = a.tex[fi]
    if t == null { return }
    var w = a.fw[fi]
    var h = a.fh[fi]
    r.drawTextureAt(t, x - w * 0.5, y - h, w, h)
}

// 左下角锚点（僵尸用：x = 身体左边缘）
export func drawAnimLeft(Renderer r, FrameAnim a, float frame, float x, float y) {
    if a.n <= 0 { return }
    var fi = frameIdx(a, frame)
    var t = a.tex[fi]
    if t == null { return }
    r.drawTextureAt(t, x, y - a.fh[fi], a.fw[fi], a.fh[fi])
}

// 顶部中心锚点（子弹用：x,y = 中心）
export func drawAnimMid(Renderer r, FrameAnim a, float frame, float x, float y) {
    if a.n <= 0 { return }
    var fi = frameIdx(a, frame)
    var t = a.tex[fi]
    if t == null { return }
    var w = a.fw[fi]
    var h = a.fh[fi]
    r.drawTextureAt(t, x - w * 0.5, y - h * 0.5, w, h)
}

// 按 fps 推进帧（返回新帧号）
export func stepFrame(FrameAnim a, float cur): float {
    if a.n <= 0 { return 0.0 }
    var nf = cur + 1.0
    while nf >= _float(a.interval * a.n) { nf = nf - _float(a.interval * a.n) }
    return nf
}

// 帧号 → 动画帧下标
export func frameIdx(FrameAnim a, float cur): int {
    if a.n <= 0 { return 0 }
    var fi = _int(cur / _float(a.interval))
    if fi < 0 { fi = 0 }
    while fi >= a.n { fi = fi - a.n }
    return fi
}

export func texPath(string rel): string {
    return dirs.res_dir() + "/image/" + rel
}
