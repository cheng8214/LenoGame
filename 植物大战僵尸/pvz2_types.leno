export var LV_SUN   = [150, 50, 50, 50, 50, 50, 50, 50, 50, 50, 50, 50, 50]
export var LV_GRAVE = [0, 0, 0, 0, 0, 1, 2, 3, 0, 0, 0, 0, 0]
export var LV_TITLE = [
    "白天 1-1", "白天 1-2", "白天 1-3", "白天 1-4", "白天 1-5",
    "黑夜 2-1", "黑夜 2-2", "黑夜 2-3",
    "泳池 3-1", "泳池 3-2", "泳池 3-3", "泳池 3-4",
    "浓雾 4-1"
]
