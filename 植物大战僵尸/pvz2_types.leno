// 睡觉蘑菇集合（白天场种下即睡）
export func isSleepPlant(int t): bool {
    if t == P_PUFFSHROOM or t == P_SUNSHROOM or t == P_FUMESHROOM { return true }
    if t == P_HYPNOSHROOM or t == P_SCAREDY or t == P_ICESHROOM { return true }
    if t == P_DOOMSHROOM or t == P_SEASHROOM { return true }
    return false
}
export func isWaterPlant(int t): bool {
    if t == P_LILYPAD or t == P_SEASHROOM or t == P_TANGLEKLEP { return true }
    return false
}

